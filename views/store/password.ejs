<%- include('partials/head') %>
<body class="password-page">
  <main class="password-box">
    <h1><%= store.name %></h1>
    <p><%= store.password_message %></p>
    <% for (const f of flash) { %><div class="flash flash-<%= f.type %>"><%= f.message %></div><% } %>
    <form action="/password" method="post" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="password" name="password" placeholder="Enter store password" required aria-label="Store password">
      <button class="btn">Enter</button>
    </form>
    <p class="muted small">Are you the store owner? <a href="/admin/login">Log in here</a></p>
  </main>
</body>
</html>
