<a class="product-card" href="/products/<%= p.handle %>">
  <div class="product-card-media">
    <% if (p.image) { %><img src="<%= p.image %>" alt="<%= p.images[0].alt || p.title %>" loading="lazy"><% } else { %><div class="placeholder"></div><% } %>
    <% if (!p.available && theme.show_sold_out_badge) { %><span class="badge badge-soldout">Sold out</span>
    <% } else if (p.on_sale && theme.show_sale_badge) { %><span class="badge badge-sale">Sale</span><% } %>
  </div>
  <div class="product-card-info">
    <% if (theme.show_vendor && p.vendor) { %><div class="vendor"><%= p.vendor %></div><% } %>
    <h3><%= p.title %></h3>
    <div class="price">
      <% if (p.price_min !== p.price_max) { %>From <% } %><%= money(p.price_min) %>
      <% if (p.on_sale) { %><s class="compare"><%= money(p.compare_at_max) %></s><% } %>
    </div>
  </div>
</a>
