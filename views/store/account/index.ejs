<%- include('../partials/header') %>
<div class="container section">
  <h1 class="page-title">My account</h1>
  <%- include('nav') %>
  <div class="account-layout">
    <section>
      <h2>Order history</h2>
      <% if (!orders.length) { %>
        <p class="muted">You haven't placed any orders yet. <a href="/collections/all">Start shopping</a></p>
      <% } else { %>
        <table class="data-table">
          <thead><tr><th>Order</th><th>Date</th><th>Payment</th><th>Fulfillment</th><th class="right">Total</th></tr></thead>
          <tbody>
          <% for (const o of orders) { %>
            <tr>
              <td><a href="/account/orders/<%= o.number %>"><%= o.name %></a></td>
              <td><%= formatDate(o.created_at) %></td>
              <td><span class="status status-<%= o.financial_status %>"><%= o.financial_status.replace('_', ' ') %></span></td>
              <td><span class="status status-<%= o.status === 'cancelled' ? 'cancelled' : o.fulfillment_status %>"><%= o.status === 'cancelled' ? 'cancelled' : o.fulfillment_status %></span></td>
              <td class="right"><%= money(o.total) %></td>
            </tr>
          <% } %>
          </tbody>
        </table>
      <% } %>
    </section>
    <aside>
      <h2>Profile</h2>
      <form action="/account/profile" method="post" class="stack-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="grid-2">
          <label class="field">First name <input name="first_name" value="<%= customer.first_name %>"></label>
          <label class="field">Last name <input name="last_name" value="<%= customer.last_name %>"></label>
        </div>
        <label class="field">Phone <input name="phone" value="<%= customer.phone %>"></label>
        <p class="muted small"><%= customer.email %></p>
        <label class="check"><input type="checkbox" name="accepts_marketing" value="1" <%= customer.accepts_marketing ? 'checked' : '' %>> Email me with news and offers</label>
        <button class="btn btn-secondary">Save profile</button>
      </form>
      <h3 class="mt">Reminders</h3>
      <form action="/account/preferences" method="post" class="stack-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label class="check"><input type="checkbox" name="email_reminders" value="1" <%= customer.email_reminders !== 0 ? 'checked' : '' %>> Email me appointment and invoice reminders</label>
        <label class="check"><input type="checkbox" name="sms_opt_in" value="1" <%= customer.sms_opt_in ? 'checked' : '' %>> Text me appointment reminders</label>
        <label class="field">Mobile number for texts <input name="sms_phone" value="<%= customer.phone %>" placeholder="+15551234567"></label>
        <p class="muted small">Texts only ever contain the time and place of an appointment — never health information. Untick to stop.</p>
        <button class="btn btn-secondary">Save reminders</button>
      </form>
      <% if (address) { %>
        <h3 class="mt">Default address</h3>
        <%- include('../../partials/address', { a: address }) %>
      <% } %>
      <a class="link" href="/account/addresses">Manage addresses</a>
    </aside>
  </div>
</div>
<%- include('../partials/footer') %>
