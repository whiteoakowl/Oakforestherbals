<%- include('../partials/header') %>
<div class="page">
  <%- include('../partials/page-header', { heading: lead.name, backHref: '/admin/leads', badges: [[(STAGES.find(([k]) => k === lead.stage) || [, lead.stage])[1], lead.stage === 'client' ? 'success' : lead.stage === 'lost' ? 'default' : 'info']] }) %>
  <div class="layout-2">
    <div>
      <form method="post" action="/admin/leads/<%= lead.id %>" class="card form-stack">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <h2>Add to the conversation</h2>
        <label class="field"><span>Note</span><textarea name="add_note" rows="3" placeholder="e.g. Called — interested in digestive support, will book after holidays"></textarea></label>
        <div class="grid-3">
          <label class="field"><span>Stage</span><select name="stage"><% for (const [k, l] of STAGES) { %><option value="<%= k %>" <%= k === lead.stage ? 'selected' : '' %>><%= l %></option><% } %></select></label>
          <label class="field"><span>Next follow-up</span><input type="date" name="next_follow_up" value="<%= lead.next_follow_up ? new Date(lead.next_follow_up).toISOString().slice(0, 10) : '' %>"></label>
          <label class="field"><span>Owner</span><select name="owner_id"><option value="">Nobody</option><% for (const s of people) { %><option value="<%= s.id %>" <%= s.id === lead.owner_id ? 'selected' : '' %>><%= s.name %></option><% } %></select></label>
        </div>
        <label class="field"><span>If not going ahead, why?</span><input name="lost_reason" value="<%= lead.lost_reason %>"></label>
        <div class="right"><button class="btn btn-primary">Save</button></div>
      </form>
      <div class="card"><h2>History</h2>
        <% if (lead.interest) { %><p class="note-text"><strong>Enquiry:</strong> <%= lead.interest %></p><% } %>
        <p class="note-text small"><%= lead.notes || 'No notes yet.' %></p>
        <p class="muted small">Added <%= formatDate(lead.created_at, true) %> · last updated <%= formatDate(lead.updated_at, true) %></p>
      </div>
    </div>
    <div>
      <form method="post" action="/admin/leads/<%= lead.id %>" class="card form-stack">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="stage" value="<%= lead.stage %>">
        <h2>Contact</h2>
        <label class="field"><span>Name</span><input name="name" value="<%= lead.name %>"></label>
        <label class="field"><span>Email</span><input type="email" name="email" value="<%= lead.email %>"></label>
        <label class="field"><span>Phone</span><input name="phone" value="<%= lead.phone %>"></label>
        <label class="field"><span>Source</span><select name="source"><% for (const s of SOURCES) { %><option <%= s === lead.source ? 'selected' : '' %>><%= s %></option><% } %><% if (lead.source && !SOURCES.includes(lead.source)) { %><option selected><%= lead.source %></option><% } %></select></label>
        <button class="btn">Save contact</button>
      </form>
      <div class="card form-stack">
        <h2>Ready to go ahead?</h2>
        <% if (customer) { %><p class="small">Linked to <% if (can('customers.view')) { %><a href="/admin/customers/<%= customer.id %>"><%= customer.email %></a><% } else { %><%= customer.email %><% } %><%= patient ? ' · has a clinic record' : '' %>.</p><% } %>
        <form method="post" action="/admin/leads/<%= lead.id %>/convert" class="form-stack">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <% if (can('clinic.records.manage') && !patient) { %><label class="check small"><input type="checkbox" name="clinic" value="1" checked> Also open a clinic record</label><% } %>
          <button class="btn btn-primary">Make them a <%= customer ? 'client' : 'customer' %></button>
        </form>
        <% if (lead.email && (can('scheduling.manage') || can('scheduling.own')) && customer) { %><a class="btn btn-secondary btn-sm" href="/admin/schedule/appointments/new?customer=<%= customer.id %>">Book a consult</a><% } %>
        <% if (lead.email) { %><a class="btn btn-sm" href="mailto:<%= lead.email %>">Email</a><% } %>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
