<%- include('head') %>
<body>
<header class="topbar">
  <button class="topbar-menu" data-sidebar-toggle aria-label="Toggle navigation">☰</button>
  <a href="/admin" class="topbar-brand"><span class="brand-mark"><%= store.name.charAt(0) %></span><span class="brand-name"><%= store.name %></span></a>
  <% if (can('products.manage')) { %>
  <form class="topbar-search" action="/admin/products" method="get" role="search">
    <%- include('icon', { name: 'search', size: 16 }) %>
    <input name="q" placeholder="Search products" aria-label="Search products">
  </form>
  <% } else { %><div class="topbar-search-spacer"></div><% } %>
  <a class="topbar-bell" href="/admin/communications/notifications" aria-label="Notifications<%= typeof unreadCount !== 'undefined' && unreadCount ? ` (${unreadCount} unread)` : '' %>">🔔<% if (typeof unreadCount !== 'undefined' && unreadCount) { %><span class="bell-count"><%= unreadCount > 9 ? '9+' : unreadCount %></span><% } %></a>
  <div class="topbar-user">
    <details class="user-menu">
      <summary><span class="avatar"><%= staff.name.split(' ').map((p) => p[0]).join('').slice(0, 2).toUpperCase() %></span><span class="user-name"><%= staff.name %></span></summary>
      <div class="menu-pop">
        <div class="muted small"><%= staff.email %></div>
        <a href="/admin/profile">Your profile</a>
        <a href="/" target="_blank" rel="noopener">View online store</a>
        <form action="/admin/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link-plain">Log out</button></form>
      </div>
    </details>
  </div>
</header>
<div class="admin-shell">
  <nav class="sidebar" data-sidebar>
    <% const isActive = (prefix, exact) => exact ? adminPath === prefix : adminPath === prefix || adminPath.startsWith(prefix + '/'); %>
    <% for (const section of adminNav) { %>
      <% if (section.label) { %><div class="nav-label"><%= section.label %></div><% } %>
      <ul>
        <% for (const item of section.items) { %>
          <% const children = item.children && item.children.length ? item.children : null; %>
          <% const open = isActive(item.href, item.exact) || (children && children.some((c) => isActive(c.href, c.exact) || (c.match && c.match.test(adminPath)))); %>
          <li>
            <a href="<%= children ? children[0].href : item.href %>" class="nav-item <%= open && !children ? 'active' : '' %> <%= open && children ? 'open' : '' %>"><%- include('icon', { name: item.icon }) %><%= item.label %>
              <% if (item.storeLink) { %><span class="nav-eye" title="View store" data-open-store><%- include('icon', { name: 'eye', size: 16 }) %></span><% } %>
            </a>
            <% if (children && open) { %>
              <ul class="subnav">
                <% for (const c of children) { %>
                  <% const childActive = c.exact ? (adminPath === c.href || (c.match && c.match.test(adminPath))) : isActive(c.href); %>
                  <li><a href="<%= c.href %>" class="<%= childActive ? 'active' : '' %>"><%= c.label %></a></li>
                <% } %>
              </ul>
            <% } %>
          </li>
        <% } %>
      </ul>
    <% } %>
    <% if (showSettings) { %>
    <ul class="sidebar-bottom">
      <li><a href="/admin/settings" class="nav-item <%= isActive('/admin/settings') && !isActive('/admin/settings/preferences') ? 'active' : '' %>"><%- include('icon', { name: 'settings' }) %>Settings</a></li>
    </ul>
    <% } %>
  </nav>
  <main class="main">
    <% if (flash.length) { %>
      <div class="toasts">
        <% for (const f of flash) { %><div class="toast toast-<%= f.type %>" role="status"><%= f.message %></div><% } %>
      </div>
    <% } %>
