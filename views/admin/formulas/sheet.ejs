<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %></title>
<style>body{font-family:Helvetica,Arial,sans-serif;color:#111;background:#fff;max-width:760px;margin:24px auto;padding:0 16px}table{width:100%;border-collapse:collapse;margin:12px 0}th,td{text-align:left;padding:6px 8px;border-bottom:1px solid #ccc}.num{text-align:right}.box{border:1px solid #111;width:90px;height:22px}.muted{color:#555}h1{margin:0}@media print{.noprint{display:none}}</style></head>
<body>
  <p class="noprint"><button onclick="window.print()">Print</button></p>
  <h1><%= f.name %></h1>
  <p class="muted"><%= store.name %> · version <%= f.version %> (<%= f.status %>) · batch: <%= target ? `${target.qty} ${UNITS[target.unit].label}` : `${f.yield_qty} ${UNITS[f.yield_unit].label}` %></p>
  <h2>Weighing sheet</h2>
  <table><thead><tr><th>Ingredient</th><th class="num">Target</th><th>Lot used</th><th>Weighed</th><th>Initials</th></tr></thead><tbody>
    <% for (const l of resolved.lines) { const q = l.amount * factor; %><tr><td><%= l.name %></td><td class="num"><%= Math.round(q * 100) / 100 %> <%= UNITS[l.amount_unit].label %></td><td><div class="box"></div></td><td><div class="box"></div></td><td><div class="box" style="width:50px"></div></td></tr><% } %>
  </tbody></table>
  <% if (f.instructions) { %><h2>Method</h2><p style="white-space:pre-wrap"><%= f.instructions %></p><% } %>
  <% if (f.storage || f.shelf_life_days) { %><p><strong>Storage:</strong> <%= f.storage %> <%= f.shelf_life_days ? `· shelf life ${f.shelf_life_days} days` : '' %></p><% } %>
  <% if (safety.entries.length || f.safety_notes) { %><h2>Safety</h2><% for (const e of safety.entries) { %><p><strong><%= e.common_name %> (<%= e.kind %>):</strong> <%= e.description %> <span class="muted">— <%= e.source_title %></span></p><% } %><% if (f.safety_notes) { %><p><%= f.safety_notes %></p><% } %><% } %>
</body></html>
