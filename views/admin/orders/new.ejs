<%- include('../partials/header') %>
<form action="/admin/orders/new" method="post" class="page">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <%- include('../partials/page-header', { heading: 'Create order', backHref: '/admin/orders' }) %>
  <div class="layout-2">
    <div>
      <div class="card">
        <h2>Products</h2>
        <div data-lines>
          <div class="line-row" data-line-row>
            <select name="lines[0][variant_id]" class="grow" aria-label="Product">
              <option value="">Choose a product…</option>
              <% for (const v of variants) { %><option value="<%= v.id %>"><%= v.product_title %><%= v.title !== 'Default Title' ? ` – ${v.title}` : '' %> · <%= money(v.price) %><%= v.track_inventory ? ` (${v.inventory_qty} available)` : '' %></option><% } %>
            </select>
            <input type="number" name="lines[0][quantity]" value="1" min="1" class="tiny-input" aria-label="Quantity">
            <button type="button" class="btn btn-plain" data-remove-line aria-label="Remove">✕</button>
          </div>
        </div>
        <button type="button" class="btn" data-add-line>+ Add another product</button>
      </div>
      <div class="card form-stack">
        <h2>Shipping &amp; payment</h2>
        <div class="grid-2">
          <label class="field"><span>Shipping label</span><input name="shipping_name" value="Standard shipping"></label>
          <label class="field"><span>Shipping price</span><div class="input-prefix"><span><%= store.currency_symbol %></span><input name="shipping_price" value="0.00" inputmode="decimal"></div></label>
        </div>
        <label class="field"><span>Discount code (optional)</span><input name="discount_code"></label>
        <label class="field"><span>Note</span><textarea name="note" rows="2"></textarea></label>
        <label class="check"><input type="checkbox" name="mark_paid" value="1"> Mark as paid</label>
      </div>
    </div>
    <div>
      <div class="card form-stack">
        <h2>Customer</h2>
        <label class="field"><span>Email</span><input type="email" name="email" required></label>
        <div class="grid-2">
          <label class="field"><span>First name</span><input name="first_name"></label>
          <label class="field"><span>Last name</span><input name="last_name"></label>
        </div>
        <label class="field"><span>Address</span><input name="address1"></label>
        <label class="field"><span>Apartment, suite</span><input name="address2"></label>
        <div class="grid-2">
          <label class="field"><span>City</span><input name="city"></label>
          <label class="field"><span>State</span><input name="province"></label>
        </div>
        <div class="grid-2">
          <label class="field"><span>ZIP</span><input name="zip"></label>
          <label class="field"><span>Country</span><select name="country"><% for (const [code, name] of COUNTRIES) { %><option value="<%= code %>"><%= name %></option><% } %></select></label>
        </div>
        <label class="field"><span>Phone</span><input name="phone"></label>
      </div>
    </div>
  </div>
  <div class="page-footer"><span></span><button class="btn btn-primary">Create order</button></div>
</form>
<%- include('../partials/footer') %>
