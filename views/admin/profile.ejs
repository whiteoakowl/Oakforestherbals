<%- include('partials/header') %>
<div class="page narrow">
  <%- include('partials/page-header', { heading: 'Your profile' }) %>
  <form action="/admin/profile" method="post" class="card form-stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label class="field"><span>Name</span><input name="name" value="<%= staff.name %>"></label>
    <label class="field"><span>Email</span><input value="<%= staff.email %>" disabled></label>
    <h3>Change password</h3>
    <div class="grid-2">
      <label class="field"><span>Current password</span><input type="password" name="current_password" autocomplete="current-password"></label>
      <label class="field"><span>New password</span><input type="password" name="new_password" minlength="8" autocomplete="new-password"></label>
    </div>
    <div><button class="btn btn-primary">Save</button></div>
  </form>
</div>
<%- include('partials/footer') %>
