<% const figure = (cx) => `M${cx} 10a12 12 0 1 1 0 24a12 12 0 1 1 0-24z M${cx - 6} 34h12v6h-12z M${cx - 22} 42q22-6 44 0l2 70h-48z M${cx - 22} 44l-14 58l7 2l13-46 M${cx + 22} 44l14 58l-7 2l-13-46 M${cx - 20} 112l-4 90h12l6-74l6 74h12l-4-90z`; %>
<svg viewBox="0 0 200 210" class="body-figure" <%- typeof interactive !== 'undefined' && interactive ? 'data-body-chart role="img" aria-label="Body chart. Click to add a marker."' : 'role="img" aria-label="Body chart"' %>>
  <text x="50" y="208" text-anchor="middle" class="fig-label">Front</text><text x="150" y="208" text-anchor="middle" class="fig-label">Back</text>
  <path d="<%= figure(50) %>" class="fig"/><path d="<%= figure(150) %>" class="fig"/>
  <line x1="100" y1="6" x2="100" y2="200" class="fig-divider"/>
  <g data-markers><% (marks || []).forEach((m, i) => { %><g class="marker"><circle cx="<%= m.x * 2 %>" cy="<%= m.y * 2.1 %>" r="5"/><text x="<%= m.x * 2 %>" y="<%= m.y * 2.1 + 2.5 %>" text-anchor="middle"><%= i + 1 %></text></g><% }) %></g>
</svg>
